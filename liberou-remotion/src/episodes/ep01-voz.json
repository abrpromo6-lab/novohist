{
  "1-0": {
    "file": "voz/ep01/1-0.mp3",
    "sec": 5.93,
    "who": "cida",
    "text": "Arroz, vela e pilha. E volta direto, hein? Hoje não é dia de enrolar."
  },
  "2-0": {
    "file": "voz/ep01/2-0.mp3",
    "sec": 2.16,
    "who": "voce",
    "text": "Todo ano a mesma coisa..."
  },
  "3-0": {
    "file": "voz/ep01/3-0.mp3",
    "sec": 3.36,
    "who": "voce",
    "text": "Que isso... parece véspera de Natal."
  },
  "4-0": {
    "file": "voz/ep01/4-0.mp3",
    "sec": 3.95,
    "who": "mulher",
    "text": "Pega tudo, menino. Amanhã não vai ter nada aberto."
  },
  "5-0": {
    "file": "voz/ep01/5-0.mp3",
    "sec": 2.14,
    "who": "briga1",
    "text": "Larga que esse aí é meu! Eu peguei primeiro!"
  },
  "6-0": {
    "file": "voz/ep01/6-0.mp3",
    "sec": 1.84,
    "who": "voce",
    "text": "Acabou o cadeado..."
  },
  "8-0": {
    "file": "voz/ep01/8-0.mp3",
    "sec": 2.56,
    "who": "voce",
    "text": "Por que eles tão olhando pra mim..."
  },
  "9-0": {
    "file": "voz/ep01/9-0.mp3",
    "sec": 3.76,
    "who": "voce",
    "text": "Eles já tão de máscara. Ainda nem é de noite."
  },
  "10-0": {
    "file": "voz/ep01/10-0.mp3",
    "sec": 3.14,
    "who": "homem1",
    "text": "Rua 7. A casa do portão verde."
  },
  "11-0": {
    "file": "voz/ep01/11-0.mp3",
    "sec": 2.69,
    "who": "homem2",
    "text": "A da enfermeira? Tem certeza?"
  },
  "12-0": {
    "file": "voz/ep01/12-0.mp3",
    "sec": 4.64,
    "who": "homem1",
    "text": "Ela deixou meu irmão morrer na fila do posto. Esse ano ela não escapa."
  },
  "13-0": {
    "file": "voz/ep01/13-0.mp3",
    "sec": 1.64,
    "who": "homem2",
    "text": "...tem alguém ouvindo?"
  },
  "14-0": {
    "file": "voz/ep01/14-0.mp3",
    "sec": 2.32,
    "who": "caixa",
    "text": "Ô moleque! Teu troco!"
  },
  "15-0": {
    "file": "voz/ep01/15-0.mp3",
    "sec": 1.6,
    "who": "voce",
    "text": "Portão verde..."
  },
  "16-0": {
    "file": "voz/ep01/16-0.mp3",
    "sec": 2.64,
    "who": "cida",
    "text": "Cadê o arroz? Cadê a vela?"
  },
  "17-0": {
    "file": "voz/ep01/17-0.mp3",
    "sec": 8,
    "who": "voce",
    "text": "Mãe... dois caras no mercado. Falaram da casa do portão verde. Da enfermeira."
  },
  "18-0": {
    "file": "voz/ep01/18-0.mp3",
    "sec": 2.97,
    "who": "biel",
    "text": "Mãe... a enfermeira é você."
  },
  "19-0": {
    "file": "voz/ep01/19-0.mp3",
    "sec": 6.48,
    "who": "cida",
    "text": "O menino do posto... o Marquinhos. Eu não tinha leito, filho."
  },
  "20-0": {
    "file": "voz/ep01/20-0.mp3",
    "sec": 5.92,
    "who": "tiarosa",
    "text": "Manda pelo menos o Biel pra cá. O último ônibus sai 18:30. O ponto é na esquina."
  },
  "21-0": {
    "file": "voz/ep01/21-0.mp3",
    "sec": 2.72,
    "who": "biel",
    "text": "Ele tá parado no ponto de ônibus..."
  },
  "22-0": {
    "file": "voz/ep01/22-0.mp3",
    "sec": 3.16,
    "who": "cida",
    "text": "Eu não saio. É a mim que eles querem."
  },
  "22-1": {
    "file": "voz/ep01/22-1.mp3",
    "sec": 4.95,
    "who": "cida",
    "text": "E o Biel... você decide. Você que viu eles."
  }
}